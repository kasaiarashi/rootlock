# RootLock Environment Configuration
# Copy this file to .env and update with your values

# Database
DB_PASSWORD=your_secure_database_password_here
DATABASE_URL=postgresql://rootlock:your_password@localhost:5432/rootlock?sslmode=disable

# Redis
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://default:your_password@localhost:6379/0

# JWT
JWT_SECRET=your_very_long_random_jwt_secret_at_least_32_characters

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENV=development

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=RootLock Password Manager
WEBAUTHN_RP_ORIGINS=http://localhost:3000,http://localhost:8080

# Session
SESSION_DURATION_MINUTES=15
REFRESH_TOKEN_DURATION_DAYS=30

# Security
BCRYPT_COST=12
ARGON2_MEMORY=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=4

# Optional: External Services
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@rootlock.kriaa.in
# SMTP_PASSWORD=your_smtp_password
